<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">commercegears_customerapproval_queue_listing.commercegears_customerapproval_queue_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>commercegears_customerapproval_queue_columns</spinner>
        <deps>
            <dep>commercegears_customerapproval_queue_listing.commercegears_customerapproval_queue_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="commercegears_customerapproval_queue_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">entity_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>CommerceGears_CustomerApproval::manage</aclResource>
        <dataProvider class="CommerceGears\CustomerApproval\Ui\DataProvider\QueueDataProvider" name="commercegears_customerapproval_queue_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filterSearch name="fulltext"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <action name="approve">
                <settings>
                    <url path="commercegears_customerapproval/customer/massApprove"/>
                    <type>approve</type>
                    <label translate="true">Approve</label>
                </settings>
            </action>
            <action name="reject">
                <settings>
                    <confirm>
                        <message translate="true">Reject the selected customer accounts? They cannot sign in. To add a reason, use the Reject button on the customer page.</message>
                        <title translate="true">Reject Accounts</title>
                    </confirm>
                    <url path="commercegears_customerapproval/customer/massReject"/>
                    <type>reject</type>
                    <label translate="true">Reject</label>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="commercegears_customerapproval_queue_columns" component="CommerceGears_CustomerApproval/js/grid/listing">
        <selectionsColumn name="ids">
            <settings>
                <indexField>entity_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="entity_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
            </settings>
        </column>
        <column name="name" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">Name</label>
            </settings>
        </column>
        <column name="email" sortOrder="30">
            <settings>
                <filter>text</filter>
                <fieldClass>
                    <class name="sw-ca-email">true</class>
                </fieldClass>
                <label translate="true">Email</label>
            </settings>
        </column>
        <column name="commercegears_approval_status" class="CommerceGears\CustomerApproval\Ui\Component\Listing\Column\ApprovalStatus" sortOrder="40">
            <settings>
                <options class="CommerceGears\CustomerApproval\Model\Attribute\Source\Status"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <label translate="true">Approval Status</label>
            </settings>
        </column>
        <column name="commercegears_approval_reason" sortOrder="50">
            <settings>
                <filter>text</filter>
                <label translate="true">Rejection Reason</label>
            </settings>
        </column>
        <column name="group_id" component="Magento_Ui/js/grid/columns/select" sortOrder="60">
            <settings>
                <options class="Magento\Customer\Model\Customer\Source\Group"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Group</label>
            </settings>
        </column>
        <column name="website_id" component="Magento_Ui/js/grid/columns/select" sortOrder="70">
            <settings>
                <options class="Magento\Store\Model\ResourceModel\Website\Collection"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Website</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="billing_company" sortOrder="80">
            <settings>
                <filter>text</filter>
                <label translate="true">Company</label>
            </settings>
        </column>
        <column name="billing_country_id" component="Magento_Ui/js/grid/columns/select" sortOrder="90">
            <settings>
                <options class="Magento\Customer\Model\ResourceModel\Address\Attribute\Source\CountryWithWebsites"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Country</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="100">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Registered</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <actionsColumn name="actions" class="CommerceGears\CustomerApproval\Ui\Component\Listing\Column\QueueActions" sortOrder="200">
            <settings>
                <indexField>entity_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
