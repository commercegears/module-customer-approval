<?php
/**
 * CommerceGears Customer Approval: notice on the Luma registration form.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \CommerceGears\CustomerApproval\ViewModel\RegistrationNotice $viewModel
 */
$viewModel = $block->getData('view_model');
$notice = $viewModel->getNotice();
if ($notice === '') {
    return;
}
?>
<div class="message info commercegears-approval-notice" role="note">
    <div><?= $escaper->escapeHtml($notice) ?></div>
</div>
