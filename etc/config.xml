<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <commercegears_customerapproval>
            <general>
                <enabled>0</enabled>
                <mode>all</mode>
                <groups/>
                <auto_approve_groups/>
                <auto_approve_domains/>
            </general>
            <frontend>
                <show_registration_notice>1</show_registration_notice>
                <registration_notice>New accounts are reviewed by our team before you can sign in. We will email you as soon as your account has been approved.</registration_notice>
                <registration_message>Thank you for registering. Your account needs to be approved before you can sign in. We will email you as soon as it has been reviewed.</registration_message>
                <pending_message>Your account is waiting for approval. We will email you as soon as it has been reviewed.</pending_message>
                <rejected_message>Your account application was not approved. Please contact us if you think this is a mistake.</rejected_message>
                <redirect_page/>
            </frontend>
            <admin_notification>
                <enabled>1</enabled>
                <recipients/>
                <template>commercegears_customerapproval_admin_notification_template</template>
            </admin_notification>
            <customer_notification>
                <sender>general</sender>
                <approved_enabled>1</approved_enabled>
                <approved_template>commercegears_customerapproval_customer_notification_approved_template</approved_template>
                <rejected_enabled>1</rejected_enabled>
                <rejected_template>commercegears_customerapproval_customer_notification_rejected_template</rejected_template>
                <include_reason>0</include_reason>
            </customer_notification>
        </commercegears_customerapproval>
    </default>
</config>
